# Leave the Sanity values empty to run on the built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Viewer token from sanity.io/manage > API > Tokens. Needed for draft mode and live preview.
SANITY_API_READ_TOKEN=
# Public URL of the site, used for canonical links, the sitemap and social images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo submits and validates without sending email.
ENQUIRY_DEMO_MODE=false
# Production email transport. Use a sender on a verified Resend domain.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Optional controlled inbox for end-to-end delivery testing.
ENQUIRY_TEST_RECIPIENT=
